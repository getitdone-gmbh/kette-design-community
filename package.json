{
  "name": "@getitdone-gmbh/kette-design-community",
  "version": "0.4.2",
  "description": "Free, composable and accessible React components for complex business software, and a solid base to build your own. shadcn/ui + Radix UI, Tailwind CSS, TypeScript.",
  "license": "MIT",
  "author": "Get IT Done GmbH",
  "homepage": "https://components.itdone.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getitdone-gmbh/kette-design-community.git"
  },
  "bugs": {
    "url": "https://github.com/getitdone-gmbh/kette-design-community/issues"
  },
  "keywords": [
    "react",
    "shadcn",
    "shadcn-ui",
    "radix-ui",
    "tailwindcss",
    "design-system",
    "components",
    "typescript",
    "enterprise",
    "complex-software"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./styles/theme.css",
    "./animation.css": "./styles/animation.css",
    "./styles.css": "./dist/styles.css",
    "./tailwind/preset": "./tailwind/preset.cjs",
    "./package.json": "./package.json",
    "./document-surface.css": "./styles/document-surface.css",
    "./flags/*": "./flags/*"
  },
  "files": [
    "dist",
    "styles",
    "tailwind",
    "flags",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "rimraf dist && vite build && tailwindcss -c tailwind.config.cjs -i styles/build.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "storybook": "storybook dev -p 9009",
    "build-storybook": "storybook build",
    "registry:build": "node scripts/build-registry.mjs && shadcn build -o public/r",
    "sync:stories": "node scripts/sync-stories.mjs",
    "theme:prune": "node scripts/prune-theme-refs.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^3.3.0"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "date-fns": "^2.30.0",
    "embla-carousel-react": "^8.5.1",
    "libphonenumber-js": "^1.11.3",
    "lucide-react": "^0.379.0",
    "react-day-picker": "^8.9.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-hook-form": "^7.47.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-themer": "^3.1.2",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "7.6.13",
    "@storybook/addon-essentials": "7.6.13",
    "@storybook/blocks": "7.6.13",
    "@storybook/jest": "^0.2.3",
    "@storybook/react": "7.6.13",
    "@storybook/react-vite": "7.6.13",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "14.5.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.31",
    "postcss-import": "^16.1.0",
    "postcss-selector-parser": "^6.1.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "rollup-plugin-preserve-directives": "^0.2.0",
    "shadcn": "^4.22.1",
    "storybook": "7.6.13",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.12",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.6.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.18.20": true
  }
}
